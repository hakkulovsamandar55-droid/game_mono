# ============================================================================
# Telegram bot tokeni — initData tekshiruvi uchun majburiy (productionda).
# ============================================================================
BOT_TOKEN=123456:AA...

# Mini App manzili (Telegram botdagi WebApp tugmasi uchun)
WEBAPP_URL=https://economic-village.onrender.com

# Render PORT ni o'zi beradi — mahalliy ishlash uchun:
PORT=3000

# Productionda aniq domenni ko'rsating. `*` faqat vaqtinchalik lokal
# sinov uchun; Render'da servis manzilini yozing.
CORS_ORIGIN=https://economic-village.onrender.com

# Brauzerda Telegramsiz sinash. PRODUCTIONDA 0 QILING —
# aks holda istalgan odam soxta foydalanuvchi bo'lib kira oladi.
ALLOW_DEV_AUTH=0

# SQLite fayli joylashadigan papka.
# Render'da doimiy disk ulasangiz: /var/data
DATA_DIR=./data
